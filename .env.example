# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Comma-separated list of Telegram User IDs allowed to use the bot
TELEGRAM_ADMIN_IDS=123456789,987654321

# School 21 OpenAPI Credentials
S21_LOGIN=your_s21_login
S21_PASSWORD=your_s21_password

# Campus & Target Coalitions Configuration
CAMPUS_ID=5a23bec9-f989-485d-935b-3f0dc61c4812
# Format: coalition_id:coalition_name,coalition_id:coalition_name
TARGET_COALITIONS=604:Northern,605:Powder,606:Secret

# Monitoring & Validation Settings
TZ=Europe/Moscow
CHECK_INTERVAL_MINUTES=60
# Target project IDs to check (comma-separated). Default includes Week 01 & Week 02 projects
TARGET_PROJECT_IDS=73187,73188,73189,73328,73190,73191,73192,73193,73194,73195,73196
# Minimum number of projects from TARGET_PROJECT_IDS that must be ACCEPTED for VERIFIED status
# Target wave / class name to filter (e.g. 25_10_NN or 24_10_NN). Leave empty to check all waves.
TARGET_CLASS_NAME=25_10_NN
MIN_LOGTIME=0.0


